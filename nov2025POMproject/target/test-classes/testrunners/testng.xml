<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="opencart login page regression suite" parallel="tests"
	thread-count="5">
	<listeners>
		<listener class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener class-name="com.opencart.qa.listeners.TestAllureListener" />
		<listener class-name="com.opencart.qa.listeners.AnnotationTransformer" />
	</listeners>
	
	<test name="Login Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.opencart.qa.test.LoginPageTest" />
		</classes>
	</test> <!--Test -->
	<test name="Home Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.opencart.qa.test.HomePageTest" />
		</classes>
	</test>
	<test name="ProductInfoPageTest Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.opencart.qa.test.ProductInfoPageTest" />
		</classes>
	</test> 
	<test name="Register Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.opencart.qa.test.RegisterPageTest" />
		</classes>
	</test>
</suite> <!--Suite -->
